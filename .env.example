# ============================================================
# Botseri : Environment Variables (ARCHITECTURE.md §4.5)
# Copy to .env and fill in values.
# Generate secrets: bash scripts/gen-secrets.sh > .env
# ============================================================

# --- Database (required) ---
POSTGRES_USER=botseri
POSTGRES_PASSWORD=
POSTGRES_DB=botseri

# --- Encryption (required) ---
# 32-byte key, base64-encoded. For AES-256-GCM encryption of secrets in DB.
ENCRYPTION_KEY=
# Previous key during rotation (optional)
# ENCRYPTION_KEY_PREVIOUS=

# --- Internal API (required) ---
# Random token for n8n <-> dashboard communication
INTERNAL_API_TOKEN=

# --- Dashboard session (required) ---
SESSION_SECRET=

# --- Setup (optional) ---
# If empty, generated once and printed to dashboard logs on first run
# SETUP_TOKEN=

# --- Public URL (required) ---
# Used for OAuth redirect URIs. Example: https://panel.yourdomain.com
PUBLIC_BASE_URL=https://panel.yourdomain.com

# --- Timezone (required) ---
TZ_DEFAULT=Asia/Jakarta

# --- Customer Inbound Session (optional) ---
# Pause TTL in hours before paused customer session automatically resets to active (default 24)
CUSTOMER_PAUSE_TTL_HOURS=24

# --- WAHA (required) ---
WAHA_API_KEY=
WAHA_SESSION=default

# --- n8n (required) ---
N8N_ENCRYPTION_KEY=

# --- Pinned image versions (required) ---
# [VERIFY] pick latest stable at repo init, record in docs/VERSIONS.md
N8N_VERSION=1.64.1
WAHA_VERSION=latest-2026.9.2
CLOUDFLARED_VERSION=2024.10.1

# --- Cloudflare Tunnel (required if using tunnel profile) ---
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Logging (optional) ---
# LOG_LEVEL=info

# --- NOT HERE (§4.5) ---
# LLM API keys, Google credentials, WhatsApp numbers
# → entered via dashboard, stored encrypted in DB
