    {
      "id": "filter-event",
      "name": "Filter Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const input = $json.body ?? $json ?? {};\nconst payload = input.payload ?? {};\nconst from = String(payload.from ?? '');\nconst target = String(payload.fromMe ? (payload.to || payload.chatId || payload.from) : from);\nconst isBlockedChat = !target || target.endsWith('@g.us') || target.includes('@newsletter') || target === 'status@broadcast' || target.includes('@broadcast');\nif (input.event !== 'message' || isBlockedChat) return [];\nreturn [{ json: { event: input.event, session: input.session ?? 'default', payload } }];"
      }
    },
    {
      "id": "http-accept",
      "name": "Accept",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DASHBOARD_URL }}/api/internal/inbound/accept",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ wa_message_id: $json.payload.id, chat_id: $json.payload.fromMe ? ($json.payload.to || $json.payload.chatId || $json.payload.from) : $json.payload.from, from: $json.payload.from, participant: $json.payload.participant || null, phone: $json.payload.phone || null, remote_jid_alt: $json.payload._data?.key?.remoteJidAlt || $json.payload.remoteJidAlt || null, sender_pn: $json.payload._data?.key?.senderPn || $json.payload.senderPn || null, author: $json.payload.author || $json.payload._data?.author || null, body: $json.payload.body || null, has_media: $json.payload.hasMedia === true, media_type: $json.payload.media?.mimetype || null, from_me: $json.payload.fromMe === true, received_at: new Date(Number($json.payload.timestamp || 0) > 1e11 ? Number($json.payload.timestamp) : Number($json.payload.timestamp || Date.now() / 1000) * 1000).toISOString() }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "botseriInternalApi",
          "name": "Botseri Internal API"
        }
      }
    },
