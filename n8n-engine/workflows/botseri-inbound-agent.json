    {
      "id": "split-output",
      "name": "Pecah Pesan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2900,
        100
      ],
      "parameters": {
        "jsCode": "const rawOutput = $json.output || $json.text || ($json.message && $json.message.content) || '';\nlet finalReply = typeof rawOutput === 'string' ? rawOutput.trim() : (rawOutput && typeof rawOutput === 'object' && typeof rawOutput.text === 'string' ? rawOutput.text.trim() : JSON.stringify(rawOutput));\nif (!finalReply) {\n  console.warn('[botseri-n8n] Output agen kosong atau gagal memproses tool:', JSON.stringify($json));\n  finalReply = 'Maaf, terjadi kendala saat memeriksa atau mencatat tugas. Coba ulangi sebentar lagi ya.';\n}\nconst parts = [];\nlet buffer = '';\nfor (const paragraph of finalReply.split(/\\n{2,}/)) {\n  const candidate = buffer ? `${buffer}\\n\\n${paragraph}` : paragraph;\n  if (candidate.length <= 3500) { buffer = candidate; continue; }\n  if (buffer) parts.push(buffer);\n  if (paragraph.length <= 3500) { buffer = paragraph; continue; }\n  for (let i = 0; i < paragraph.length; i += 3500) parts.push(paragraph.slice(i, i + 3500));\n  buffer = '';\n}\nif (buffer) parts.push(buffer);\nconst chatId = $('Filter Event').item.json.payload.from;\nreturn parts.map((part) => ({ json: { chat_id: chatId, text: part } }));"
      }
    },
