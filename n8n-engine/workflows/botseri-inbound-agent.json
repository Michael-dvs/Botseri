        100
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const rawPhone = item.json.phone_e164 || item.json.to || '';\n  const cleanDigits = String(rawPhone).replace(/\\D/g, '');\n  return {\n    json: {\n      phone_e164: rawPhone,\n      chat_id: item.json.chat_id || (cleanDigits ? cleanDigits + '@c.us' : ''),\n      body: item.json.body || item.json.text || '',\n      trigger_type: item.json.trigger_type || 'CUSTOMER_REPLY'\n    }\n  };\n});"
      }
    },
